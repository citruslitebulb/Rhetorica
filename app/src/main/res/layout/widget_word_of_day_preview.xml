<?xml version="1.0" encoding="utf-8"?>
<!-- Picker preview. Labels only — the live widget fills these from today's word. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/playfair_display"
            android:maxLines="1"
            android:text="@string/widget_default_word"
            android:textColor="@color/widget_gold"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="@string/widget_default_definition"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_preview_orator"
            android:textColor="@color/widget_gold"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
