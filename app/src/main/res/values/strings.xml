    <string name="onboarding_welcome_body">Rhetorica is a daily ritual of rhetorical language drawn from history\'s great speeches. One word each day. Offline. Yours.</string>
    <string name="onboarding_welcome_questions">A few questions first, so the feed is built around the voices you actually want — not every orator in the catalog.</string>
    <string name="onboarding_voices_title">What are you looking for?</string>
    <string name="onboarding_voices_body">Choose the voices that belong in your daily feed. Classical philosophers are selected to start. Skip or add individual orators later in Settings.</string>
    <string name="onboarding_voices_need_one">Select at least one family to continue.</string>
    <string name="onboarding_family_classical_title">Classical philosophers &amp; orators</string>
    <string name="onboarding_family_classical_body">Ancient persuasion and Stoic reflection — Demosthenes, Cicero, Marcus Aurelius.</string>
    <string name="onboarding_family_statesmen_title">Historical statesmen</string>
    <string name="onboarding_family_statesmen_body">Civic speech that shaped nations — Lincoln, Churchill, the founding generation.</string>
    <string name="onboarding_family_justice_title">Justice &amp; human rights</string>
    <string name="onboarding_family_justice_body">Dignity, rights, and moral courage — Douglass, King, Mandela.</string>
    <string name="onboarding_family_literary_title">Literary voices</string>
    <string name="onboarding_family_literary_body">Language shaped for the page and the stage — Shakespeare, Angelou.</string>
    <string name="onboarding_family_technology_title">Business &amp; technology</string>
    <string name="onboarding_family_technology_body">The rhetoric of invention and product — Jobs, Gates, and Silicon Valley.</string>
    <string name="onboarding_family_fictional_title">Fictional &amp; film</string>
    <string name="onboarding_family_fictional_body">Invented mentors and movie speeches — Yoda, Gandalf, Rocky. Off unless you want them.</string>
    <string name="onboarding_family_examples">Including %1$s</string>
