<?xml version="1.0" encoding="utf-8"?>
<!-- Dark card with a gold outer rule and a burgundy inner rule, matching the app theme. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_gold" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_burgundy" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item
        android:bottom="5dp"
        android:left="5dp"
        android:right="5dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_card_background" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</layer-list>
